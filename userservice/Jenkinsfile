pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '939760948670'
        AWS_REGION     = 'us-east-1'
        ECR_REPO       = 'travel-userservice'
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        ECR_URI        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    }

    stages {

        stage('Run Tests') {
            steps {
                dir('userservice') {
                    sh 'mvn -pl userservice -am -f ../pom.xml test'
                }
            }
        }

        stage('Build Jar') {
            steps {
                sh 'mvn -pl userservice -am -f pom.xml clean package -Dmaven.test.skip=true'
            }
        }

        stage('Build Docker Image') {
            when { branch 'main' }
            steps {
                sh "docker build -f userservice/Dockerfile -t ${ECR_URI}:${IMAGE_TAG} -t ${ECR_URI}:latest ."
            }
        }

        stage('Push to ECR') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        docker push ${ECR_URI}:${IMAGE_TAG}
                        docker push ${ECR_URI}:latest
                    """
                }
            }
        }

        stage('Check EKS') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    script {
                        def rc = sh(
                            script: "aws eks describe-cluster --name travel-learning-cluster --region ${AWS_REGION} > /dev/null 2>&1",
                            returnStatus: true)
                        env.EKS_UP = (rc == 0) ? 'true' : 'false'
                        echo "EKS cluster available: ${env.EKS_UP}"
                    }
                }
            }
        }

        stage('Approve Production Deploy') {
            when { allOf { branch 'main'; environment name: 'EKS_UP', value: 'true' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Deploy image ${IMAGE_TAG} to EKS production?", ok: 'Deploy'
                }
            }
        }

        stage('Deploy to EKS') {
            when { allOf { branch 'main'; environment name: 'EKS_UP', value: 'true' } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh """
                        aws eks update-kubeconfig --region ${AWS_REGION} --name travel-learning-cluster
                        kubectl set image deployment/userservice userservice=${ECR_URI}:${IMAGE_TAG}
                        kubectl rollout status deployment/userservice --timeout=180s
                    """
                }
            }
        }
    }

    post {
        success { echo "Pipeline succeeded (branch: ${env.BRANCH_NAME})" }
        failure { echo "Pipeline failed (branch: ${env.BRANCH_NAME})" }
    }
}
